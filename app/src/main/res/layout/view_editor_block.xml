<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:background="@drawable/bg_block"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <EditText
        android:id="@+id/block_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/editor_heading_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/block_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/block_add_entry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/cd_add_entry"
            android:text="@string/action_add_item"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/block_up"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_block_up"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/block_down"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_block_down"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/block_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_block"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_trash" />
    </LinearLayout>
</LinearLayout>
