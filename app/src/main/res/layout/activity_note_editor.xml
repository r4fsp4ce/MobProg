<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_close" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xxs"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/folder_chip"
                style="@style/Widget.Tudow.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:drawableStart="@drawable/ic_folder"
                android:drawablePadding="@dimen/space_xs"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="32dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@null"
                android:hint="@string/editor_title_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences|textMultiLine"
                android:letterSpacing="-0.015"
                android:maxLines="4"
                android:minHeight="@dimen/touch_target"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/block_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/editor_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.mobprog.ui.RibbonView
        android:id="@+id/ribbon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ribbon_margin"
        android:layout_marginEnd="@dimen/ribbon_margin"
        android:layout_marginBottom="@dimen/ribbon_margin" />
</LinearLayout>
