<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/quick_entry_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="@dimen/space_xxs"
        android:buttonTint="@color/checkbox_tint"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quick_entry_prefix"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="44dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- The text column takes the marker's remaining width; the item's priority and
         deadline sit under its own text, like the full editor. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/quick_entry_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="center_vertical|start"
            android:hint="@string/editor_item_hint"
            android:imeOptions="actionNone"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="44dp"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/quick_entry_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xxs"
            android:visibility="gone">

            <TextView
                android:id="@+id/quick_entry_priority"
                style="@style/Widget.Tudow.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/quick_entry_deadline"
                style="@style/Widget.Tudow.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xxs"
                android:clickable="true"
                android:drawableStart="@drawable/ic_clock_small"
                android:drawablePadding="2dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
