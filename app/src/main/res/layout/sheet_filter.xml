<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filter_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/TextAppearance.Tudow.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/sort_by" />

        <RadioGroup
            android:id="@+id/sort_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/sort_updated"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/sort_updated" />

            <RadioButton
                android:id="@+id/sort_created"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/sort_created" />

            <RadioButton
                android:id="@+id/sort_deadline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/sort_deadline" />

            <RadioButton
                android:id="@+id/sort_priority"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/sort_priority" />

            <RadioButton
                android:id="@+id/sort_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/sort_title" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.Tudow.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/filter_colors" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/color_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="@dimen/space_xxs">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_default"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_default" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_red"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_red" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_orange"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_orange" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_yellow"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_yellow" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_green"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_green" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_teal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_teal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_blue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_blue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_indigo"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_indigo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_purple"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_purple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_pink"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_pink" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_brown"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_brown" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_color_gray"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/color_gray" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/TextAppearance.Tudow.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/filter_priority" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/priority_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_1"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/priority_1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_2"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/priority_2" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority_3"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/priority_3" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/TextAppearance.Tudow.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/filter_status" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/status_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_any"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/filter_status_any" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_open"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/filter_status_open" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_done"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/filter_status_done" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_deadline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/filter_has_deadline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filter_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_clear_filters" />

            <Button
                android:id="@+id/filter_apply"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/action_apply" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
