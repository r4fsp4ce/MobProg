<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/grid_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/color_hairline"
    app:strokeWidth="@dimen/card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp">

        <!-- Title row: the pin sits in a fixed 14 dp slot, so it never moves. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="4"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/card_pin_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginTop="3dp"
                android:contentDescription="@string/card_pin_description"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:lineSpacingExtra="1.5sp"
            android:maxLines="6"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/card_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/card_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/card_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/card_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/color_accent"
                app:trackColor="@color/color_hairline"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/card_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pills wrap downwards; the overflow button keeps a fixed 40 dp slot. -->
        <LinearLayout
            android:id="@+id/card_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.mobprog.ui.PillFlowLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/card_priority"
                    style="@style/Widget.Tudow.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_flag_small"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/card_deadline"
                    style="@style/Widget.Tudow.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />
            </com.example.mobprog.ui.PillFlowLayout>

            <ImageButton
                android:id="@+id/card_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
