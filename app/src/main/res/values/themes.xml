    <!-- Tonal card: no shadow, one hairline outline. -->
    <style name="Widget.Tudow.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="strokeColor">@color/color_hairline</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.Tudow.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Tudow.ScreenTitle</item>
    </style>

    <style name="TextAppearance.Tudow.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inconsolata</item>
        <item name="fontFamily">@font/inconsolata</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Tudow.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inconsolata</item>
        <item name="fontFamily">@font/inconsolata</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Small pill used for priority and deadline on cards. -->
    <style name="Widget.Tudow.Pill" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:fontFamily">@font/inconsolata</item>
        <item name="fontFamily">@font/inconsolata</item>
        <item name="android:paddingStart">@dimen/chip_padding_h</item>
        <item name="android:paddingEnd">@dimen/chip_padding_h</item>
        <item name="android:paddingTop">@dimen/chip_padding_v</item>
        <item name="android:paddingBottom">@dimen/chip_padding_v</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:textSize">@dimen/text_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.Tudow.RibbonButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Tudow.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeFillColor">@color/nav_item_fill</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Tudow.NavItem</item>
        <item name="itemShapeInsetStart">8dp</item>
        <item name="itemShapeInsetEnd">8dp</item>
        <item name="itemShapeInsetTop">2dp</item>
        <item name="itemShapeInsetBottom">2dp</item>
        <item name="itemIconTint">@color/nav_item_colors</item>
        <item name="itemTextColor">@color/nav_item_colors</item>
        <item name="android:background">@color/color_surface</item>
    </style>

    <style name="Widget.Tudow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
    </style>

    <style name="ShapeAppearance.Tudow.NavItem" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Tudow.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
